{
  "name": "heibon-mahjong",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --config wrangler.jsonc --port 8787",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 tests/*.test.ts tests/*.test.mjs",
    "test:file": "node --test --test-concurrency=1",
    "test:browser": "python tests/run-browser-regressions.py",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test:online:production": "node tests/online-production.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.151.2",
    "ws": "^8.22.0"
  }
}
