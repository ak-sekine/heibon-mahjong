{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heibon-mahjong-online-dev",
  "main": "worker/development.ts",
  "compatibility_date": "2026-04-07",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimitDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomDurableObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "RateLimitDurableObject"
      ]
    }
  ]
}
